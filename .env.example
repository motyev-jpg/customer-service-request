# Copy to .env and adjust. Never commit .env.
# Secret used to sign session cookies. If empty, a random one is generated at each start.
SECRET_KEY=change-me
# Optional: location of the SQLite file (default: data/csrm.db)
# DB_PATH=data/csrm.db
# Phone number that opens the Airtable admin screen instead of the dashboard (default: 543210)
# ADMIN_PHONE=543210
# Optional: location of the settings file that holds the Airtable token (default: next to the database)
# SETTINGS_PATH=data/settings.json
# Set to 1 for Flask debug mode (development only)
FLASK_DEBUG=0
